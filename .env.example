DB_URL=jdbc:mysql://localhost:3306/earnings?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=earnings
DB_PASSWORD=earnings
SEC_USER_AGENT=
# Select one provider globally; unused provider keys may be left empty.
LLM_PROVIDER=OPENAI
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-sol
OPENAI_MAX_INPUT_CHARS=60000
OPENAI_CONNECT_TIMEOUT=10s
OPENAI_READ_TIMEOUT=120s
OPENAI_PROXY_HOST=
OPENAI_PROXY_PORT=0
# To use DeepSeek, set LLM_PROVIDER=DEEPSEEK and supply this key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_INPUT_CHARS=60000
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_CONNECT_TIMEOUT=10s
DEEPSEEK_READ_TIMEOUT=120s
DEEPSEEK_PROXY_HOST=
DEEPSEEK_PROXY_PORT=0
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EARNINGS_MONITOR_ENABLED=true
EARNINGS_MONITOR_INTERVAL_SECONDS=30
EARNINGS_FILING_LOOKBACK_DAYS=30
EARNINGS_RECOVERY_BATCH_SIZE=20
EARNINGS_SIMULATION_ENABLED=false

# Shared dynamic Runtime. Also switches earnings analysis to this Runtime when enabled.
SELF_INVESTOR_AGENT_ENABLED=false
SELF_INVESTOR_AGENT_MAX_STEPS=12
SELF_INVESTOR_AGENT_MAX_LLM_CALLS=12
SELF_INVESTOR_AGENT_MAX_REPEATED_TOOL_CALLS=2
SELF_INVESTOR_AGENT_MAX_TOOL_FAILURES=5
SELF_INVESTOR_AGENT_QUEUE_CAPACITY=100

# Requires SELF_INVESTOR_AGENT_ENABLED=true. No automatic macro data feed in V1.
SELF_INVESTOR_MACRO_ENABLED=false
SELF_INVESTOR_MACRO_MAX_STEPS=15
SELF_INVESTOR_MACRO_MAX_LLM_CALLS=15
SELF_INVESTOR_MACRO_NOTIFICATIONS_ENABLED=false

MARKET_STRESS_ENABLED=false
MARKET_STRESS_SYMBOLS=QQQ
MARKET_STRESS_RSI_PERIOD=6
MARKET_STRESS_RSI_TRIGGER=30
MARKET_STRESS_COOLDOWN_HOURS=12
MARKET_STRESS_SCHEDULER_ENABLED=true
MARKET_STRESS_INTERVAL_MINUTES=60
MARKET_STRESS_MARKET_HOURS_ONLY=true
FINNHUB_API_KEY=your-finnhub-api-key
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_VIX_SYMBOL=^VIX

MARKET_STRESS_EMAIL_ENABLED=false
MARKET_STRESS_EMAIL_RECIPIENTS=you@example.com
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=zhouxin.hzau.hust@gmail.com
MAIL_PASSWORD=your-mail-app-password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
