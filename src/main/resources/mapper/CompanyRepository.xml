<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.selfinvestor.earnings.repository.CompanyRepository">
    <resultMap id="CompanyMap" type="com.selfinvestor.earnings.company.CompanyPO">
        <id property="id" column="id"/>
        <result property="ticker" column="ticker"/>
        <result property="cik" column="cik"/>
        <result property="companyName" column="company_name"/>
        <result property="enabled" column="enabled"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="CompanyColumns">id, ticker, cik, company_name, enabled, created_at, updated_at</sql>

    <select id="findAllByEnabledTrueOrderByTicker" resultMap="CompanyMap">
        SELECT <include refid="CompanyColumns"/> FROM COMPANY WHERE enabled = TRUE ORDER BY ticker
    </select>
    <select id="findByTickerIgnoreCase" resultMap="CompanyMap">
        SELECT <include refid="CompanyColumns"/> FROM COMPANY WHERE UPPER(ticker) = UPPER(#{ticker}) LIMIT 1
    </select>
    <select id="findById" resultMap="CompanyMap">
        SELECT <include refid="CompanyColumns"/> FROM COMPANY WHERE id = #{id}
    </select>
    <select id="findAll" resultMap="CompanyMap">
        SELECT <include refid="CompanyColumns"/> FROM COMPANY ORDER BY ticker
    </select>
    <insert id="insert" parameterType="com.selfinvestor.earnings.company.CompanyPO"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO COMPANY (ticker, cik, company_name, enabled, created_at, updated_at)
        VALUES (#{ticker}, #{cik}, #{companyName}, #{enabled}, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
    </insert>
    <update id="updateEnabled">
        UPDATE COMPANY SET enabled = #{enabled}, updated_at = CURRENT_TIMESTAMP WHERE id = #{id}
    </update>
</mapper>
