  "$defs": {
    "metric":{"type":["object","null"],"additionalProperties":false,"required":["value","yoyGrowth","qoqGrowth"],"properties":{"value":{"type":["string","null"]},"yoyGrowth":{"type":["number","null"]},"qoqGrowth":{"type":["number","null"]}}},
    "margin":{"type":["object","null"],"additionalProperties":false,"required":["value","previousQuarter","trend"],"properties":{"value":{"type":["string","null"]},"previousQuarter":{"type":["string","null"]},"trend":{"type":["string","null"]}}},
    "segment":{"type":"object","additionalProperties":false,"required":["name","revenue","yoyGrowth","qoqGrowth","commentary"],"properties":{"name":{"type":"string"},"revenue":{"type":["string","null"]},"yoyGrowth":{"type":["number","null"]},"qoqGrowth":{"type":["number","null"]},"commentary":{"type":["string","null"]}}}
  }
