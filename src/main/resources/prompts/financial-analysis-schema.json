{
  "type": "object",
  "additionalProperties": false,
  "required": ["company","ticker","fiscalQuarter","headline","financials","guidance","segments","positives","negatives","risks","managementCommentary","fundamentalTrend","fundamentalTrendReason","investmentThesisChanged","investmentThesisChangeReason","consensusComparisonAvailable","consensusComparisonNote","qualityScore","summary"],
  "properties": {
