{
  "type":"object","additionalProperties":false,
  "required":["fiscalQuarter","researchPlan","researchTasks","initialHypotheses"],
  "properties":{
    "fiscalQuarter":{"type":["string","null"]},
    "researchPlan":{"$ref":"#/$defs/plan"},
    "researchTasks":{"type":"array","maxItems":8,"items":{"$ref":"#/$defs/task"}},
    "initialHypotheses":{"type":"array","items":{"$ref":"#/$defs/hypothesis"}}
  },
  "$defs":{
    "plan":{"type":"object","additionalProperties":false,"required":["objective","focusAreas","rationale"],"properties":{"objective":{"type":"string"},"focusAreas":{"type":"array","items":{"$ref":"#/$defs/category"}},"rationale":{"type":"string"}}},
    "task":{"type":"object","additionalProperties":false,"required":["taskId","category","question","reason","priority","status"],"properties":{"taskId":{"type":["string","null"]},"category":{"$ref":"#/$defs/category"},"question":{"type":"string"},"reason":{"type":"string"},"priority":{"type":"string","enum":["HIGH","MEDIUM","LOW"]},"status":{"type":"string","enum":["PENDING"]}}},
    "hypothesis":{"type":"object","additionalProperties":false,"required":["hypothesisId","statement","status","confidence"],"properties":{"hypothesisId":{"type":["string","null"]},"statement":{"type":"string"},"status":{"type":"string","enum":["UNTESTED","SUPPORTED","REJECTED","INCONCLUSIVE"]},"confidence":{"type":"number","minimum":0,"maximum":1}}},
    "category":{"type":"string","enum":["REVENUE","EPS","MARGIN","CASH_FLOW","GUIDANCE","SEGMENT","EXPECTATION","MANAGEMENT_COMMENTARY","OTHER"]}
  }
}
